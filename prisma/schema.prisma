generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
  OTHER
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  RETURNED
}

enum ReturnStatus {
  COMPLETED
  CANCELLED
}

model Shop {
  id String @id @default(cuid())
  name String
  address String?
  phone String?
  email String?
  gstin String?
  invoicePrefix String @default("INV")
  users User[]
  counters Counter[]
  products Product[]
  categories Category[]
  customers Customer[]
  suppliers Supplier[]
  sales Sale[]
  purchases Purchase[]
  expenses Expense[]
  returns SaleReturn[]
  inventoryMovements InventoryMovement[]
  auditLogs AuditLog[]
  expenseCategories ExpenseCategory[]
  invoiceCounters InvoiceCounter[]
  customerCreditLedgers CustomerCreditLedger[]
  shifts Shift[]
  offers Offer[]
  printerSettings PrinterSetting[]
  receiptTemplates ReceiptTemplate[]
  quickAccessProducts QuickAccessProduct[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  name String
  email String @unique
  passwordHash String
  role Role
  active Boolean @default(true)
  counterId String?
  counter Counter? @relation(fields: [counterId], references: [id])
  permissions UserPermission[]
  sales Sale[]
  returns SaleReturn[]
  expenses Expense[]
  auditLogs AuditLog[]
  idempotencyKeys IdempotencyKey[]
  shifts Shift[]
  customerCreditLedgers CustomerCreditLedger[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Counter {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  name String
  users User[]
  shifts Shift[]
  createdAt DateTime @default(now())
}

model Permission {
  id String @id @default(cuid())
  code String @unique
  description String?
  users UserPermission[]
}

model UserPermission {
  id String @id @default(cuid())
  userId String
  permissionId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  enabled Boolean @default(true)
  @@unique([userId, permissionId])
}

model Category {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  name String
  parentId String?
  parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[] @relation("MainCategory")
  subProducts Product[] @relation("SubCategory")
  offers Offer[]
  @@unique([shopId, name])
}

model Product {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  sku String
  barcode String?
  name String
  description String?
  brand String?
  unit String @default("pcs")
  purchasePrice Decimal
  sellingPrice Decimal
  mrp Decimal?
  taxRate Decimal @default(0)
  stock Decimal @default(0)
  minimumStock Decimal @default(0)
  categoryId String?
  category Category? @relation("MainCategory", fields: [categoryId], references: [id])
  subcategoryId String?
  subCategory Category? @relation("SubCategory", fields: [subcategoryId], references: [id])
  batchNumber String?
  expiryDate DateTime?
  supplierId String?
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  imageUrl String?
  active Boolean @default(true)
  saleItems SaleItem[]
  purchaseItems PurchaseItem[]
  inventoryMovements InventoryMovement[]
  returnItems ReturnItem[]
  offers Offer[]
  quickAccessProducts QuickAccessProduct[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shopId, sku])
  @@unique([shopId, barcode])
  @@index([shopId, name])
  @@index([shopId, barcode])
  @@index([shopId, brand])
}

model Customer {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  name String
  phone String?
  email String?
  address String?
  gstin String?
  creditBalance Decimal @default(0)
  sales Sale[]
  creditLedgers CustomerCreditLedger[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shopId, phone])
  @@index([shopId, name])
}

model Supplier {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  name String
  phone String?
  email String?
  address String?
  gstin String?
  payableBalance Decimal @default(0)
  purchases Purchase[]
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  invoiceNumber String
  cashierId String
  cashier User @relation(fields: [cashierId], references: [id])
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])
  subtotal Decimal
  discount Decimal @default(0)
  tax Decimal @default(0)
  total Decimal
  idempotencyKey String?
  status SaleStatus @default(COMPLETED)
  items SaleItem[]
  payments Payment[]
  returns SaleReturn[]
  creditLedgers CustomerCreditLedger[]
  createdAt DateTime @default(now())
  @@unique([shopId, invoiceNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, createdAt])
}

model SaleItem {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Decimal
  unitPrice Decimal
  unitCost Decimal
  discount Decimal @default(0)
  tax Decimal @default(0)
  total Decimal
  returnItems ReturnItem[]
}

model Payment {
  id String @id @default(cuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method PaymentMethod
  amount Decimal
  createdAt DateTime @default(now())
}

model Purchase {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  supplierId String?
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  invoiceNumber String
  total Decimal
  items PurchaseItem[]
  createdAt DateTime @default(now())
  @@unique([shopId, invoiceNumber])
}

model PurchaseItem {
  id String @id @default(cuid())
  purchaseId String
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Decimal
  unitPrice Decimal
  total Decimal
}

model SaleReturn {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  saleId String
  sale Sale @relation(fields: [saleId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  refundAmount Decimal
  reason String
  status ReturnStatus @default(COMPLETED)
  items ReturnItem[]
  createdAt DateTime @default(now())
}

model ReturnItem {
  id String @id @default(cuid())
  returnId String
  return SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem SaleItem @relation(fields: [saleItemId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Decimal
  amount Decimal
}

model InventoryMovement {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  type InventoryMovementType
  quantity Decimal
  referenceId String?
  reason String?
  userId String?
  createdAt DateTime @default(now())
  @@index([shopId, productId, createdAt])
}

model ExpenseCategory {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  name String
  expenses Expense[]
  @@unique([shopId, name])
}

model Expense {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  userId String?
  user User? @relation(fields: [userId], references: [id])
  categoryId String?
  category ExpenseCategory? @relation(fields: [categoryId], references: [id])
  categoryName String?
  amount Decimal
  description String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  userId String?
  user User? @relation(fields: [userId], references: [id])
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([shopId, createdAt])
}

model InvoiceCounter {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  year Int
  value Int @default(0)
  @@unique([shopId, year])
}

model IdempotencyKey {
  id String @id @default(cuid())
  shopId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation String
  key String
  response Json?
  createdAt DateTime @default(now())
  @@unique([shopId, operation, key])
  @@index([shopId, createdAt])
}

model CustomerCreditLedger {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId String?
  sale Sale? @relation(fields: [saleId], references: [id])
  userId String?
  user User? @relation(fields: [userId], references: [id])
  type String // CREDIT_GIVEN | PAYMENT_RECEIVED
  amount Decimal
  notes String?
  createdAt DateTime @default(now())
  @@index([shopId, customerId, createdAt])
}

model Shift {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  counterId String?
  counter Counter? @relation(fields: [counterId], references: [id])
  startTime DateTime @default(now())
  endTime DateTime?
  openingCash Decimal @default(0)
  cashSales Decimal @default(0)
  cashRefunds Decimal @default(0)
  cashExpenses Decimal @default(0)
  expectedCash Decimal @default(0)
  actualCash Decimal?
  difference Decimal?
  notes String?
  status String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shopId, userId, status])
}

model Offer {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id])
  name String
  code String?
  type String // PERCENTAGE | FIXED | BUY_X_GET_Y | MIN_BILL
  value Decimal @default(0)
  minBillAmount Decimal?
  buyQty Int?
  getQty Int?
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id])
  productId String?
  product Product? @relation(fields: [productId], references: [id])
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shopId, active])
}

model PrinterSetting {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  counterId String?
  printerName String @default("Default Thermal Printer")
  paperWidth String @default("80mm")
  copies Int @default(1)
  autoPrint Boolean @default(true)
  cutPaper Boolean @default(true)
  openCashDrawer Boolean @default(false)

  // Header Customization
  shopName String?
  tagline String?
  address String?
  phone String?
  email String?
  gstin String?
  website String?
  additionalHeader String?

  // Logo
  logoUrl String?
  showLogo Boolean @default(true)
  logoAlign String @default("center")

  // Header Options
  showShopName Boolean @default(true)
  showTagline Boolean @default(true)
  showAddress Boolean @default(true)
  showPhone Boolean @default(true)
  showGstin Boolean @default(true)
  showEmail Boolean @default(false)
  showWebsite Boolean @default(false)
  headerAlign String @default("center")

  // Item Columns
  showProductName Boolean @default(true)
  showQuantity Boolean @default(true)
  showRate Boolean @default(true)
  showDiscount Boolean @default(true)
  showTax Boolean @default(true)
  showTotal Boolean @default(true)
  showSku Boolean @default(false)
  showBarcode Boolean @default(false)

  // Bill Info Options
  showInvoiceNum Boolean @default(true)
  showDate Boolean @default(true)
  showTime Boolean @default(true)
  showCounterNum Boolean @default(true)
  showCashierName Boolean @default(true)
  showCustomerName Boolean @default(true)
  showCustomerPhone Boolean @default(false)
  showCustomerGstin Boolean @default(false)

  // Bill Summary Options
  showSubtotal Boolean @default(true)
  showSummaryDiscount Boolean @default(true)
  showGstTax Boolean @default(true)
  showOtherCharges Boolean @default(false)
  showGrandTotal Boolean @default(true)

  // Payment Info Options
  showPaymentMethod Boolean @default(true)
  showAmountReceived Boolean @default(true)
  showChangeReturned Boolean @default(true)
  showTransactionRef Boolean @default(false)

  // Footer
  thankYouMessage String? @default("Thank You For Shopping With Us!")
  additionalFooter String? @default("Visit Again")
  returnPolicy String? @default("Goods once sold cannot be returned without valid bill.")
  customerSupport String?
  showThankYou Boolean @default(true)
  showReturnPolicy Boolean @default(true)
  showAdditionalFooter Boolean @default(true)
  footerAlign String @default("center")

  // Barcode / QR Code
  showQrCode Boolean @default(false)
  qrTargetUrl String?
  showInvoiceBarcode Boolean @default(true)

  // Appearance
  fontSize String @default("medium")
  shopNameSize String @default("large")
  shopNameStyle String @default("bold")
  itemTextStyle String @default("normal")
  dividerStyle String @default("dashed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, counterId])
}

model ReceiptTemplate {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name String
  paperWidth String @default("80mm")
  configuration String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuickAccessProduct {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
  badgeText    String?
  badgeColor   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([shopId, productId])
  @@index([shopId, isEnabled, displayOrder])
}

